@page "/performance/my"
@inherits AppPage

<PageTitle>@T("Değerlendirmelerim", "My reviews") · EnterprisePulse</PageTitle>
<div class="ep-page-header"><MudText Typo="Typo.h5">@T("Değerlendirmelerim", "My reviews")</MudText></div>
@if (_rows == null) { <MudProgressLinear Indeterminate="true" /> }
else if (_rows.Count == 0) { <MudText>@T("Değerlendirme yok.", "There are no reviews.")</MudText> }
else
{
    <MudTable Items="_rows" Dense="true" Elevation="0" Outlined="true">
        <HeaderContent>
            <MudTh>@T("Dönem", "Cycle")</MudTh><MudTh>@T("Personel", "Employee")</MudTh><MudTh>@T("Durum", "Status")</MudTh><MudTh Style="text-align:right">@T("Puan", "Score")</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context["cycleName"]</MudTd>
            <MudTd>@context["employeeName"]</MudTd>
            <MudTd>@Meta.EnumLabel("PerformanceReviewStatus", context["status"]?.ToString() ?? "", Locale)</MudTd>
            <MudTd Style="text-align:right">@(context["overallScore"]?.ToString() ?? "—")</MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<JsonObject>? _rows;
    protected override async Task OnInitializedAsync() => await Run(async () =>
    {
        var data = await Api.GetJsonAsync("/api/performance/mine");
        _rows = data["items"] is JsonArray array ? array.Select(n => n!.AsObject()).ToList() : [];
    });
}
