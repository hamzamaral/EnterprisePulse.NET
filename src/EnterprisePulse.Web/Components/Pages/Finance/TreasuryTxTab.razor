@inherits AppPage

@if (_rows == null) { <MudProgressLinear Indeterminate="true" /> }
else if (_rows.Count == 0) { <MudText>@T("Hareket yok", "No transactions")</MudText> }
else
{
    <MudTable Items="_rows" Dense="true" Elevation="0" Outlined="true">
        <HeaderContent>
            <MudTh>@T("Tarih", "Date")</MudTh><MudTh>@T("Belge", "Document")</MudTh><MudTh>@T("Açıklama", "Description")</MudTh>
            <MudTh Style="text-align:right">@T("Giriş", "In")</MudTh><MudTh Style="text-align:right">@T("Çıkış", "Out")</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@AssetUi.Day(context["txDate"])</MudTd>
            <MudTd>@Meta.EnumLabel("TreasuryDocumentType", context["documentType"]?.ToString(), Locale) @context["documentNumber"]</MudTd>
            <MudTd>@context["description"]</MudTd>
            <MudTd Style="text-align:right">@AssetUi.Dec(context["amountIn"]).ToString("N2")</MudTd>
            <MudTd Style="text-align:right">@AssetUi.Dec(context["amountOut"]).ToString("N2")</MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    [Parameter] public JsonObject Record { get; set; } = null!;
    [Parameter] public ResourceMeta ResourceMeta { get; set; } = null!;
    [Parameter] public EventCallback OnChanged { get; set; }
    private List<JsonObject>? _rows;

    protected override async Task OnParametersSetAsync() =>
        await Run(async () => _rows = await Api.GetAsync<List<JsonObject>>($"/api/finance/accounts/{Record["id"]}/transactions") ?? []);
}
