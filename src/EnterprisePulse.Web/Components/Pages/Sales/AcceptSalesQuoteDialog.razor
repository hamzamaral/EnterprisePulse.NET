@inherits AppPage

<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">@T("Teklifi siparişe çevir", "Turn the quote into an order")</MudText></TitleContent>
    <DialogContent>
        <RefPicker Resource="warehouses" @bind-Value="_warehouse" Label="@T("Sevk deposu", "Shipping warehouse")" Required="true" />
        <MudDatePicker @bind-Date="_delivery" Label="@T("Teslim tarihi", "Delivery date")" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd.MM.yyyy" Culture="Fmt.Tr" Clearable="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">@L("cancel")</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy || string.IsNullOrEmpty(_warehouse)" OnClick="Save">@T("Kabul et", "Accept")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string QuoteId { get; set; } = "";
    private string? _warehouse;
    private DateTime? _delivery;
    private bool _busy;

    private async Task Save()
    {
        _busy = true;
        Guid? orderId = null;
        var ok = await Run(async () => orderId = await Api.PostAsync<Guid>($"/api/sales/quotes/{QuoteId}/accept",
            new { warehouseId = _warehouse, deliveryDate = _delivery == null ? null : AssetUi.Iso(_delivery) }), T("Sipariş oluşturuldu", "Order created"));
        _busy = false;
        if (ok && orderId != null)
        {
            Nav.NavigateTo($"/sales/orders/{orderId}");
            MudDialog.Close(DialogResult.Ok(true));
        }
    }

    public static async Task Open(ActionContext ctx)
    {
        await ctx.Dialogs.ShowAsync<AcceptSalesQuoteDialog>(null, new DialogParameters<AcceptSalesQuoteDialog> { { x => x.QuoteId, ctx.Id } },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        await ctx.Reload();
    }
}
