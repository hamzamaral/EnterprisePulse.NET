@page "/recruitment/interviews"
@inherits AppPage

<PageTitle>@T("Mülakatlarım", "My interviews") · EnterprisePulse</PageTitle>
<div class="ep-page-header"><MudText Typo="Typo.h5">@T("Mülakatlarım", "My interviews")</MudText></div>
@if (_rows == null) { <MudProgressLinear Indeterminate="true" /> }
else if (_rows.Count == 0) { <MudText>@T("Planlı mülakatınız yok.", "You have no interviews.")</MudText> }
else
{
    <MudTable Items="_rows" Dense="true" Elevation="0" Outlined="true">
        <HeaderContent><MudTh>@T("Aday", "Candidate")</MudTh><MudTh>@T("Tür", "Type")</MudTh><MudTh>@T("Durum", "Status")</MudTh></HeaderContent>
        <RowTemplate>
            <MudTd><MudLink Href="@($"/recruitment/applications/{context["applicationId"]}")">@context["candidateName"]</MudLink></MudTd>
            <MudTd>@Meta.EnumLabel("InterviewType", context["type"]?.ToString() ?? "", Locale)</MudTd>
            <MudTd>@Meta.EnumLabel("InterviewStatus", context["status"]?.ToString() ?? "", Locale)</MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<JsonObject>? _rows;
    protected override async Task OnInitializedAsync() => await Run(async () =>
    {
        var data = await Api.GetJsonAsync("/api/recruitment/interviews/mine");
        _rows = data["items"] is JsonArray array ? array.Select(n => n!.AsObject()).ToList() : [];
    });
}
