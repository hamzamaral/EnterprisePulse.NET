@inherits AppPage

<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">@T("İşten çıkış", "Terminate employment") · @Name</MudText></TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">@T("Zimmetli demirbaşı olan personelin çıkışı yapılamaz.", "Employees holding assets cannot be terminated.")</MudAlert>
        <MudDatePicker @bind-Date="_date" Label="@T("Çıkış tarihi", "Termination date")" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd.MM.yyyy" Culture="Fmt.Tr" Required="true" />
        <MudTextField @bind-Value="_reason" Label="@T("Çıkış nedeni", "Reason")" Lines="3" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">@L("cancel")</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="Save" Disabled="_busy || _date == null">@T("Çıkışı yap", "Terminate")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string EmployeeId { get; set; } = "";
    [Parameter] public string Name { get; set; } = "";

    private DateTime? _date = DateTime.Today;
    private string? _reason;
    private bool _busy;

    private async Task Save()
    {
        _busy = true;
        var ok = await Run(() => Api.PostAsync<JsonObject>($"/api/hr/employees/{EmployeeId}/terminate", new { terminationDate = _date!.Value.ToString("yyyy-MM-dd"), reason = _reason }), L("saved"));
        _busy = false;
        if (ok) MudDialog.Close(DialogResult.Ok(true));
    }

    public static async Task OpenAsync(ActionContext ctx)
    {
        var dialog = await ctx.Dialogs.ShowAsync<TerminateDialog>(null, new DialogParameters<TerminateDialog>
        {
            { x => x.EmployeeId, ctx.Id },
            { x => x.Name, $"{ctx.Record["firstName"]} {ctx.Record["lastName"]}" },
        }, new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        if (await dialog.Result is { Canceled: false }) await ctx.Reload();
    }
}
