@page "/forgot-password"
@inherits AppPage

<MudPaper Elevation="8" Class="pa-8" Style="width:420px;max-width:94vw">
    <MudText Typo="Typo.h5" Class="mb-4">@L("forgot")</MudText>
    @if (_sent)
    {
        <MudAlert Severity="Severity.Success">@T("Hesap varsa sıfırlama bağlantısı e-posta ile gönderildi.", "If the account exists a reset link was e-mailed.")</MudAlert>
    }
    else
    {
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_email" Label="@L("email")" Variant="Variant.Outlined" InputType="InputType.Email" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Send" Disabled="string.IsNullOrWhiteSpace(_email)">@L("sendLink")</MudButton>
        </MudStack>
    }
    <MudLink Href="/login" Class="mt-4 d-block" Typo="Typo.body2">@L("backToLogin")</MudLink>
</MudPaper>

@code {
    private string _email = "";
    private bool _sent;

    private async Task Send()
    {
        if (await Run(() => Api.PostAsync("/api/auth/forgot-password", new { email = _email }))) _sent = true;
    }
}
