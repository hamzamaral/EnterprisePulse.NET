@page "/reset-password"
@inherits AppPage

<MudPaper Elevation="8" Class="pa-8" Style="width:420px;max-width:94vw">
    <MudText Typo="Typo.h5" Class="mb-4">@L("resetPassword")</MudText>
    @if (_done)
    {
        <MudAlert Severity="Severity.Success">@T("Şifreniz güncellendi, giriş yapabilirsiniz.", "Your password was changed, you can sign in.")</MudAlert>
    }
    else
    {
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_password" Label="@L("newPassword")" Variant="Variant.Outlined" InputType="InputType.Password"
                          HelperText="@T("En az 8 karakter, büyük/küçük harf ve rakam", "At least 8 chars with upper, lower case and a digit")" />
            <MudTextField @bind-Value="_repeat" Label="@T("Yeni şifre (tekrar)", "Repeat new password")" Variant="Variant.Outlined" InputType="InputType.Password" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="string.IsNullOrEmpty(Token) || _password.Length < 8 || _password != _repeat">@L("save")</MudButton>
        </MudStack>
    }
    <MudLink Href="/login" Class="mt-4 d-block" Typo="Typo.body2">@L("backToLogin")</MudLink>
</MudPaper>

@code {
    [SupplyParameterFromQuery] public string? Token { get; set; }
    private string _password = "";
    private string _repeat = "";
    private bool _done;

    private async Task Save()
    {
        if (await Run(() => Api.PostAsync("/api/auth/reset-password", new { token = Token, password = _password }))) _done = true;
    }
}
