@inherits AppPage

<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">@Title</MudText></TitleContent>
    <DialogContent>
        @if (Message != null)
        {
            <MudText Class="mb-3">@Message</MudText>
        }
        @if (Label != null)
        {
            <MudTextField @bind-Value="_value" Label="@Label" Variant="Variant.Outlined" Lines="3" AutoFocus="true" Required="Required" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">@L("cancel")</MudButton>
        <MudButton Color="Color" Variant="Variant.Filled" Disabled="Required && string.IsNullOrWhiteSpace(_value)" OnClick="() => MudDialog.Close(DialogResult.Ok(_value ?? string.Empty))">@(OkText ?? L("save"))</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Message { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public string? OkText { get; set; }
    [Parameter] public Color Color { get; set; } = Color.Primary;

    private string? _value;

    /// <summary>Returns the entered text ("" when no input is asked) or null when cancelled.</summary>
    public static async Task<string?> AskAsync(IDialogService dialogs, string title, string? label, bool required = false, string? message = null, string? okText = null, Color color = Color.Primary)
    {
        var dialog = await dialogs.ShowAsync<PromptDialog>(null, new DialogParameters<PromptDialog>
        {
            { x => x.Title, title }, { x => x.Label, label }, { x => x.Required, required }, { x => x.Message, message }, { x => x.OkText, okText }, { x => x.Color, color },
        }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        return result is { Canceled: false } ? result.Data as string ?? "" : null;
    }
}
